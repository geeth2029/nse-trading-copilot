APP_NAME=NSE Trading Copilot API

# ── Database ───────────────────────────────────────────────────────────────────
# Local SQLite (default — do not change for local development)
DATABASE_URL=sqlite:///./data/nse_trading_copilot.db
# Neon PostgreSQL (set this in Render environment variables for production)
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/nsedb?sslmode=require

# ── Auth & session ─────────────────────────────────────────────────────────────
REGISTRATION_ENABLED=false
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=nse_session
CSRF_COOKIE_NAME=nse_csrf
SESSION_COOKIE_SECURE=true

# ── Deployment / CORS ──────────────────────────────────────────────────────────
# The exact HTTPS origin of the frontend.
# Local dev default: http://localhost:5173  (Vite dev server)
# Production:        https://your-app.vercel.app
# Set ALLOWED_ORIGIN in Render environment variables — do NOT use a wildcard.
ALLOWED_ORIGIN=http://localhost:5173

# ── Market Data Provider ───────────────────────────────────────────────────────
# 'tej' = Free End-of-Day Hugging Face Parquet mirror (recommended for free tier)
# 'upstox' = Upstox v3 API (requires UPSTOX_ANALYTICS_TOKEN)
MARKET_DATA_PROVIDER=tej
TEJ_DATA_DIR=./data/market_data/tejhq
TEJ_STATUS_URL=https://api.tejhq.dev/v1/status
TEJ_DATASET_BASE_URL=https://huggingface.co/datasets/tejhq/indian-markets/resolve/main/prices_adjusted
TEJ_AUTO_SYNC=true
TEJ_REQUEST_TIMEOUT_SECONDS=30.0
TEJ_LOOKBACK_YEARS=2
