APP_NAME=NSE Trading Copilot API
DATABASE_URL=sqlite:///./data/nse_trading_copilot.db
REGISTRATION_ENABLED=false
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=nse_session
CSRF_COOKIE_NAME=nse_csrf
SESSION_COOKIE_SECURE=true

# Market Data Provider: 'tej' (Free End-of-Day Hugging Face Parquet mirror) or 'upstox'
MARKET_DATA_PROVIDER=tej
TEJ_DATA_DIR=./data/market_data/tejhq
TEJ_STATUS_URL=https://api.tejhq.dev/v1/status
TEJ_DATASET_BASE_URL=https://huggingface.co/datasets/tejhq/indian-markets/resolve/main/prices_adjusted
TEJ_AUTO_SYNC=true
TEJ_REQUEST_TIMEOUT_SECONDS=30.0
TEJ_LOOKBACK_YEARS=2